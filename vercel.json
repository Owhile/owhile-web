{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Link",
          "value": "</llms.txt>; rel=\"llms-txt\", </llms.txt>; rel=\"describedby\""
        },
        {
          "key": "X-Llms-Txt",
          "value": "/llms.txt"
        },
        {
          "key": "Content-Signal",
          "value": "search=yes, ai-train=yes, ai-input=yes"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/creators/:name(start|profile|gates|listing).md",
      "destination": "/llms.txt",
      "permanent": false
    }
  ]
}
